# ─── Template App — Web UI Environment ──────────────────────────────────────────

# Display name shown in the header, welcome screen, and page title
VITE_APP_NAME="Template App"
VITE_APP_DESCRIPTION="A clean UI template"

# URL or public path to the brand logo (place the file in web/public/logo/)
VITE_LOGO_URL=/logo/brand-icon.png
VITE_LOAD_ICON_URL=/logo/brand-icon.png
VITE_LOAD_ICON_ALT_URL=/logo/brand-icon-grey.png

# Primary brand colour (hex). Drives the entire colour scale (buttons, accents, etc.)
VITE_PRIMARY_COLOR=#1DAB70

# ── Feature Flags ─────────────────────────────────────────────────────────────

# Set to "false" to remove the fake Phone/Tablet/PC shells and render a pure responsive app
VITE_ENABLE_DEVICE_FRAMES=true
